#!/usr/bin/env bash
# omarchy-vhost — gère des vhosts locaux (entrée /etc/hosts + reverse proxy nginx,
# avec HTTPS local optionnel via certificat mkcert ou autosigné).
#
# Usage:
#   sudo omarchy-vhost add <domaine> <port> [--no-nginx] [--https]
#   sudo omarchy-vhost remove <domaine>
#   omarchy-vhost list
set -euo pipefail

HOSTS_FILE="/etc/hosts"
NGINX_AVAILABLE="/etc/nginx/sites-available"
NGINX_ENABLED="/etc/nginx/sites-enabled"
NGINX_CONF="/etc/nginx/nginx.conf"
CERT_DIR="/etc/omarchy-vhost/certs"
MARKER="# omarchy-vhost"

usage() {
  cat >&2 <<EOF
Usage:
  sudo omarchy-vhost add <domaine> <port> [--no-nginx] [--https]
  sudo omarchy-vhost remove <domaine>
  omarchy-vhost list

Options de 'add':
  --no-nginx   N'ajoute que l'entrée /etc/hosts (pas de reverse proxy nginx)
  --https      Sert le vhost en HTTPS (certificat local mkcert si disponible,
               sinon certificat autosigné) ; le port 80 redirige vers 443.
EOF
  exit 1
}

# Ce script tourne en root (sudo/pkexec) : le domaine finit dans /etc/hosts,
# dans une config nginx et dans des chemins de fichiers (dont un rm -rf), le
# port dans proxy_pass. On n'accepte donc qu'un nom d'hôte DNS en minuscules
# (lettres, chiffres, tirets, au moins un point) et un port entier 1-65535.
validate_domain() {
  local d="$1" label='[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?'
  if [[ ${#d} -gt 253 || ! "$d" =~ ^${label}(\.${label})+$ ]]; then
    echo "omarchy-vhost: domaine invalide '${d}' (attendu : ex. monapp.test, minuscules, chiffres, tirets et points)." >&2
    exit 1
  fi
}

validate_port() {
  local p="$1"
  if [[ ! "$p" =~ ^[0-9]{1,5}$ ]] || (( 10#$p < 1 || 10#$p > 65535 )); then
    echo "omarchy-vhost: port invalide '${p}' (attendu : entier entre 1 et 65535)." >&2
    exit 1
  fi
}

# Domaine échappé pour grep -E / sed (les points sont littéraux).
domain_regex() { printf '%s' "${1//./\\.}"; }

# Fichiers nginx dont omarchy-vhost est l'auteur : la config commence par le
# marqueur, le lien de sites-enabled pointe sur cette config. Tout le reste
# appartient à l'utilisateur et n'est jamais écrasé ni supprimé.
is_managed_conf() {
  [[ -f "$1" && ! -L "$1" && "$(head -n 1 "$1")" == "$MARKER" ]]
}

is_managed_link() { # lien conf
  [[ -L "$1" && "$(readlink "$1")" == "$2" ]]
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "omarchy-vhost: cette commande nécessite sudo." >&2
    exit 1
  fi
}

has_nginx() {
  command -v nginx >/dev/null 2>&1 && [[ -d "$NGINX_AVAILABLE" ]]
}

# Propose l'installation de nginx s'il manque, avec confirmation explicite de
# l'utilisateur (jamais d'installation silencieuse). Retourne 0 si nginx est
# disponible après coup (déjà présent ou installé), 1 sinon (refus/échec).
offer_install_nginx() {
  if has_nginx; then return 0; fi

  if ! command -v pacman >/dev/null 2>&1; then
    echo "  ! nginx absent et pacman introuvable (environnement non-Arch ?) : installe-le manuellement." >&2
    return 1
  fi

  if [[ ! -t 0 ]]; then
    echo "  ! nginx n'est pas installé. Lance manuellement: sudo pacman -S nginx" >&2
    return 1
  fi

  echo "  ? nginx n'est pas installé, requis pour le reverse proxy du vhost."
  read -r -p "    Installer nginx maintenant via 'pacman -S nginx' ? [o/N] " reply
  case "$reply" in
    o|O|oui|Oui|y|Y|yes|Yes)
      echo "  … installation de nginx (pacman -S --noconfirm nginx)"
      if pacman -S --noconfirm nginx; then
        mkdir -p "$NGINX_AVAILABLE" "$NGINX_ENABLED"
        echo "  + nginx installé."
        return 0
      else
        echo "  ! échec de l'installation de nginx." >&2
        return 1
      fi
      ;;
    *)
      echo "  - installation de nginx refusée, le vhost restera limité à /etc/hosts."
      return 1
      ;;
  esac
}

# Le nginx.conf d'Arch n'inclut pas sites-enabled/ : sans cette ligne, les
# configs générées ne sont jamais chargées. On l'ajoute en tête du bloc http
# (une seule fois, marquée), on garde une copie et on la restaure si nginx -t
# échoue.
ensure_nginx_include() {
  if grep -qE "^[^#]*include[[:space:]]+(${NGINX_ENABLED}|sites-enabled)/" "$NGINX_CONF"; then
    return 0
  fi
  local backup="${NGINX_CONF}.omarchy-vhost.bak"
  cp -p "$NGINX_CONF" "$backup"
  if ! sed -i -E "0,/^[[:space:]]*http[[:space:]]*\{/s||&\n    include ${NGINX_ENABLED}/*.conf; ${MARKER}|" "$NGINX_CONF" \
     || ! grep -q "include ${NGINX_ENABLED}/\*.conf; ${MARKER}" "$NGINX_CONF" \
     || ! nginx -t >/dev/null 2>&1; then
    cp -p "$backup" "$NGINX_CONF"
    echo "omarchy-vhost: impossible d'ajouter 'include ${NGINX_ENABLED}/*.conf;' au bloc http de ${NGINX_CONF} ; ajoute-le à la main." >&2
    return 1
  fi
  echo "  + ${NGINX_CONF}: include ${NGINX_ENABLED}/*.conf (copie: ${backup})"
}

reload_nginx() {
  if nginx -t 2>/dev/null; then
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet nginx 2>/dev/null; then
      systemctl reload nginx
    else
      nginx -s reload 2>/dev/null || true
    fi
  else
    echo "omarchy-vhost: config nginx invalide, reload ignoré (vérifie avec: nginx -t)" >&2
  fi
}

# Génère (si besoin) un certificat local pour $domain dans ${CERT_DIR}/${domain}/.
# Préfère mkcert (certificat de confiance, sans avertissement navigateur) ; à
# défaut, génère un certificat autosigné avec openssl.
ensure_cert() {
  # Les messages vont sur stderr : stdout ne porte que "cert:key", capturé
  # par cmd_add.
  local domain="$1"
  local dir="${CERT_DIR}/${domain}"
  local cert="${dir}/cert.pem" key="${dir}/key.pem"

  if [[ -f "$cert" && -f "$key" ]]; then
    echo "  = certificat existant réutilisé: ${dir}" >&2
    echo "$cert:$key"
    return
  fi

  # Clé privée lisible par root uniquement.
  mkdir -p -m 700 "$dir"
  local old_umask
  old_umask="$(umask)"
  umask 077

  if command -v mkcert >/dev/null 2>&1; then
    mkcert -cert-file "$cert" -key-file "$key" "$domain" >/dev/null
    echo "  + certificat mkcert généré (root CA locale de confiance): ${dir}" >&2
  elif command -v openssl >/dev/null 2>&1; then
    openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
      -subj "/CN=${domain}" \
      -addext "subjectAltName=DNS:${domain}" \
      -keyout "$key" -out "$cert" >/dev/null 2>&1
    echo "  + certificat autosigné généré: ${dir}" >&2
    echo "    (le navigateur affichera un avertissement de confiance tant que tu ne" >&2
    echo "     l'importes pas manuellement, ou installe mkcert pour l'éviter:" >&2
    echo "     https://github.com/FiloSottile/mkcert)" >&2
  else
    echo "omarchy-vhost: ni mkcert ni openssl trouvés, impossible de générer un certificat HTTPS." >&2
    exit 1
  fi

  chmod 600 "$key"
  chmod 644 "$cert"
  umask "$old_umask"
  echo "$cert:$key"
}

cmd_add() {
  local domain="" port="" use_nginx=1 use_https=0
  local positional=()

  for arg in "$@"; do
    case "$arg" in
      --no-nginx) use_nginx=0 ;;
      --https) use_https=1 ;;
      *) positional+=("$arg") ;;
    esac
  done

  domain="${positional[0]:?domaine manquant}"
  port="${positional[1]:?port manquant}"
  [[ ${#positional[@]} -le 2 ]] || usage
  validate_domain "$domain"
  validate_port "$port"
  port=$((10#$port))

  require_root

  if [[ "$use_nginx" -eq 1 ]] && ! has_nginx; then
    offer_install_nginx || use_nginx=0
  fi

  # Conflits vérifiés avant toute écriture : une config nginx existante qui
  # n'a pas été créée par omarchy-vhost n'est jamais remplacée.
  local conf="${NGINX_AVAILABLE}/${domain}.conf"
  local link="${NGINX_ENABLED}/${domain}.conf"
  if [[ "$use_nginx" -eq 1 ]] && has_nginx; then
    if [[ -e "$conf" || -L "$conf" ]] && ! is_managed_conf "$conf"; then
      echo "omarchy-vhost: ${conf} existe et n'a pas été créé par omarchy-vhost ; rien n'a été modifié." >&2
      exit 1
    fi
    if [[ -e "$link" || -L "$link" ]] && ! is_managed_link "$link" "$conf"; then
      echo "omarchy-vhost: ${link} existe et n'a pas été créé par omarchy-vhost ; rien n'a été modifié." >&2
      exit 1
    fi
  fi

  if [[ "$use_nginx" -eq 1 ]] && has_nginx; then
    ensure_nginx_include || exit 1
  fi

  if grep -qE "^[0-9.]+\s+$(domain_regex "$domain")(\s|\$)" "$HOSTS_FILE"; then
    echo "omarchy-vhost: '${domain}' est déjà présent dans ${HOSTS_FILE}." >&2
  else
    echo "127.0.0.1 ${domain} ${MARKER}" >> "$HOSTS_FILE"
    echo "  + ${HOSTS_FILE}: 127.0.0.1 ${domain}"
  fi

  if [[ "$use_nginx" -eq 1 ]] && has_nginx; then
    # Le proxy n'écoute que sur la boucle locale (127.0.0.1, l'adresse mise
    # dans /etc/hosts) : il n'est pas joignable depuis le réseau.
    if [[ "$use_https" -eq 1 ]]; then
      local pair cert key
      pair="$(ensure_cert "$domain")"
      cert="${pair%%:*}"
      key="${pair##*:}"

      cat > "$conf" <<EOF
${MARKER}
server {
    listen 127.0.0.1:80;
    server_name ${domain};
    return 301 https://\$host\$request_uri;
}

server {
    listen 127.0.0.1:443 ssl;
    server_name ${domain};

    ssl_certificate ${cert};
    ssl_certificate_key ${key};

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
EOF
      ln -sfn "$conf" "$link"
      reload_nginx
      echo "  + nginx: reverse proxy https://${domain} -> 127.0.0.1:${port} (http redirige vers https)"
    else
      cat > "$conf" <<EOF
${MARKER}
server {
    listen 127.0.0.1:80;
    server_name ${domain};

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
EOF
      ln -sfn "$conf" "$link"
      reload_nginx
      echo "  + nginx: reverse proxy http://${domain} -> 127.0.0.1:${port}"
    fi
  elif [[ "$use_nginx" -eq 1 ]]; then
    echo "  ! nginx non détecté, vhost ajouté uniquement dans ${HOSTS_FILE}."
    echo "    Pointe ton serveur sur le port ${port} ; accès direct: http://${domain}:${port}"
    [[ "$use_https" -eq 1 ]] && echo "    (--https ignoré: nécessite nginx pour terminer le TLS)"
  fi

  echo "==> vhost '${domain}' prêt."
}

cmd_remove() {
  local domain="${1:?domaine manquant}"
  validate_domain "$domain"
  require_root

  local re
  re="$(domain_regex "$domain")"
  if grep -qE "\s${re}\s.*${MARKER}\$" "$HOSTS_FILE"; then
    sed -i -E "/\s${re}\s.*${MARKER}\$/d" "$HOSTS_FILE"
    echo "  - ${HOSTS_FILE}: entrée '${domain}' retirée"
  else
    echo "  ! aucune entrée gérée par omarchy-vhost trouvée pour '${domain}' dans ${HOSTS_FILE}" >&2
  fi

  if has_nginx; then
    local removed=0
    local conf="${NGINX_AVAILABLE}/${domain}.conf"
    local link="${NGINX_ENABLED}/${domain}.conf"
    if is_managed_link "$link" "$conf"; then
      rm -f "$link" && removed=1
    elif [[ -e "$link" || -L "$link" ]]; then
      echo "  ! ${link} n'a pas été créé par omarchy-vhost : laissé intact" >&2
    fi
    if is_managed_conf "$conf"; then
      rm -f "$conf" && removed=1
    elif [[ -e "$conf" || -L "$conf" ]]; then
      echo "  ! ${conf} n'a pas été créé par omarchy-vhost : laissé intact" >&2
    fi
    if [[ "$removed" -eq 1 ]]; then
      reload_nginx
      echo "  - nginx: config '${domain}' retirée"
    fi
  fi

  if [[ -d "${CERT_DIR}/${domain}" ]]; then
    rm -rf "${CERT_DIR}/${domain}"
    echo "  - certificat local retiré: ${CERT_DIR}/${domain}"
  fi

  echo "==> vhost '${domain}' retiré."
}

cmd_list() {
  echo "Vhosts gérés par omarchy-vhost (${HOSTS_FILE}):"
  if grep -q "${MARKER}\$" "$HOSTS_FILE" 2>/dev/null; then
    grep "${MARKER}\$" "$HOSTS_FILE" | sed 's/^/  /'
  else
    echo "  (aucun)"
  fi
  if has_nginx; then
    echo "Sites nginx gérés par omarchy-vhost:"
    local found=0
    for f in "$NGINX_AVAILABLE"/*.conf; do
      [[ -e "$f" ]] || continue
      if head -1 "$f" | grep -q "^${MARKER}\$"; then
        local scheme="http"
        grep -qE "listen [^;]*443" "$f" && scheme="https"
        echo "  - $(basename "$f" .conf)  [${scheme}]"
        found=1
      fi
    done
    [[ "$found" -eq 0 ]] && echo "  (aucun)"
  fi
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  list) shift; cmd_list "$@" ;;
  *) usage ;;
esac
