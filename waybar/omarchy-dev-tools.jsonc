// Module Waybar pour Omarchy Dev Tools.
// À fusionner dans ~/.config/waybar/config.jsonc :
//   - ajouter "custom/omarchy-dev-tools" à "modules-right"
//   - copier cet objet dans la section des modules "custom/*"
{
  "custom/omarchy-dev-tools": {
    "format": "󰙯",
    "tooltip": true,
    "tooltip-format": "Omarchy Dev Tools (Super+T)",
    "on-click": "omarchy-dev-tools",
    "on-click-right": "omarchy-dev-tools"
  }
}
